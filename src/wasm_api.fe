// Thin scalar ABI for Node and the browser. Generation, testing, reduction and
// state replay remain in Fe. JavaScript only marshals inputs and presents data.
use ingot::fuzz::{Trace, Machine, generate, replay, search, reduce, one_minimal}
use ingot::guard_machine::guard
use ingot::outcome::{roll, commit_seed, compute_payout}

fn steps(_ value: u64) -> usize {
    if value > 64 {
        64
    } else {
        value.downcast().unwrap()
    }
}

fn selected(_ target: u64, seed: u64, count: u64, reduced: u64) -> Trace {
    var model = guard(target)
    let trace = generate(model, seed, steps: steps(count))
    if reduced == 0 {
        trace
    } else {
        reduce(mut model, trace).trace
    }
}

#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_search(_ target: u64, _ seed: u64, _ cases: u64, _ count: u64) -> u64 {
    var model = guard(target)
    let found = search(mut model, seed, cases, steps: steps(count))
    if found.failure.code == 0 {
        0
    } else {
        found.attempts
    }
}

// [replay count:32][failing index:8][reduced length:8][original length:8][code:8]
#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_info(_ target: u64, _ seed: u64, _ count: u64) -> u64 {
    var model = guard(target)
    let trace = generate(model, seed, steps: steps(count))
    let result = reduce(mut model, trace)
    let length: u64 = result.trace.len.downcast().unwrap()
    let original_len: u64 = result.original_len.downcast().unwrap()
    let failing_at: u64 = result.failure.at.downcast().unwrap()
    result.failure.code
        | (original_len << 8)
        | (length << 16)
        | (failing_at << 24)
        | (result.replays << 32)
}

#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_failure(_ target: u64, _ seed: u64, _ count: u64) -> u64 {
    var model = guard(target)
    let trace = generate(model, seed, steps: steps(count))
    let failure = replay(mut model, trace)
    let at: u64 = failure.at.downcast().unwrap()
    failure.code | (at << 8)
}

// [opcode:32][value:32], bounded generator values fit in the low word.
#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_action(_ target: u64, _ seed: u64, _ count: u64, _ reduced: u64, _ index: u64) -> u64 {
    let trace = selected(target, seed, count, reduced)
    if index as u256 >= trace.len as u256 {
        return 0xffffffffffffffff
    }
    let slot: usize = index.downcast().unwrap()
    let action = trace.actions[slot]
    (action.opcode << 32) | action.value
}

// Replay a prefix of the selected trace on either the mutant or fixed target.
// [decision:8][failure:8][revoked:8][retained count:8][spent:16][remaining:16]
#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_state(
    _ target: u64,
    _ seed: u64,
    _ count: u64,
    _ reduced: u64,
    _ prefix: u64,
    _ implementation: u64,
) -> u64 {
    var trace = selected(target, seed, count, reduced)
    let bound = steps(prefix)
    if bound < trace.len {
        trace.len = bound
    }
    var model = guard(implementation)
    let failure = replay(mut model, trace)
    let remaining: u64 = model.budget.remaining.as_wei().downcast().unwrap()
    let spent: u64 = model.spent.downcast().unwrap()
    let retained: u64 = if model.memory.written < 8 {
        model.memory.written.downcast().unwrap()
    } else {
        8
    }
    let revoked: u64 = if model.policy.revoked { 1 } else { 0 }
    remaining
        | (spent << 16)
        | (retained << 32)
        | (revoked << 40)
        | (failure.code << 48)
        | (model.last_decision << 56)
}

// Bit 0: deletion-minimal for the same failure; bit 1: corrected target passes.
#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_validate(_ target: u64, _ seed: u64, _ count: u64) -> u64 {
    var mutant = guard(target)
    let trace = generate(mutant, seed, steps: steps(count))
    let result = reduce(mut mutant, trace)
    if result.failure.code == 0 {
        return 0
    }
    let minimal: u64 = if one_minimal(mut mutant, result.trace, code: result.failure.code) {
        1
    } else {
        0
    }
    var fixed = guard(0)
    let passes: u64 = if replay(mut fixed, result.trace).code == 0 {
        2
    } else {
        0
    }
    minimal | passes
}

// =====================================================================
// FairDice WASM verifier exports — compiled from the exact same
// `src/outcome.fe` source as the on-chain EVM `FairDice` contract.
// =====================================================================

fn u256_from_limbs(_ w3: u64, _ w2: u64, _ w1: u64, _ w0: u64) -> u256 {
    ((w3 as u256) << 192) | ((w2 as u256) << 128) | ((w1 as u256) << 64) | (w0 as u256)
}

fn u256_from_u128(_ hi: u64, _ lo: u64) -> u256 {
    ((hi as u256) << 64) | (lo as u256)
}

/// Recompute the FairDice roll in `0..100` from 256-bit server and client seeds
/// (each passed as four big-endian 64-bit limbs `w3..w0`) and a 64-bit bet id.
#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_roll(
    _ s3: u64,
    _ s2: u64,
    _ s1: u64,
    _ s0: u64,
    _ c3: u64,
    _ c2: u64,
    _ c1: u64,
    _ c0: u64,
    _ bet_id: u64,
) -> u64 {
    let server_seed = u256_from_limbs(s3, s2, s1, s0)
    let client_seed = u256_from_limbs(c3, c2, c1, c0)
    roll(server_seed, client_seed, bet_id: bet_id as u256).downcast().unwrap()
}

/// Verify that `commit_seed(client_seed) == commitment`. Returns 1 on match, 0 otherwise.
#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_verify_commit(
    _ c3: u64,
    _ c2: u64,
    _ c1: u64,
    _ c0: u64,
    _ h3: u64,
    _ h2: u64,
    _ h1: u64,
    _ h0: u64,
) -> u64 {
    let client_seed = u256_from_limbs(c3, c2, c1, c0)
    let commitment = u256_from_limbs(h3, h2, h1, h0)
    if commit_seed(client_seed) == commitment {
        1
    } else {
        0
    }
}

/// Verify both the dice outcome and payout for a settled bet.
/// Returns a packed u64:
///   bit 0 (1): outcome matches claimed_outcome
///   bit 1 (2): payout matches claimed_payout
///   bits 8..15: recomputed outcome (0..99)
#[unsafe(export)]
#[cfg(target = "wasm")]
pub fn fg_verify_bet(
    _ s3: u64,
    _ s2: u64,
    _ s1: u64,
    _ s0: u64,
    _ c3: u64,
    _ c2: u64,
    _ c1: u64,
    _ c0: u64,
    _ bet_id: u64,
    _ target: u64,
    _ wager_hi: u64,
    _ wager_lo: u64,
    _ claimed_outcome: u64,
    _ claimed_payout_hi: u64,
    _ claimed_payout_lo: u64,
) -> u64 {
    let server_seed = u256_from_limbs(s3, s2, s1, s0)
    let client_seed = u256_from_limbs(c3, c2, c1, c0)
    let wager = u256_from_u128(wager_hi, wager_lo)
    let claimed_payout = u256_from_u128(claimed_payout_hi, claimed_payout_lo)
    let actual_outcome = roll(server_seed, client_seed, bet_id: bet_id as u256)
    let target_u8: u8 = if target > 255 {
        255
    } else {
        target.downcast().unwrap()
    }
    let actual_payout = compute_payout(wager, target: target_u8, outcome: actual_outcome)
    let outcome_ok: u64 = if actual_outcome == (claimed_outcome as u256) {
        1
    } else {
        0
    }
    let payout_ok: u64 = if actual_payout == claimed_payout {
        2
    } else {
        0
    }
    let out_byte: u64 = actual_outcome.downcast().unwrap()
    outcome_ok | payout_ok | (out_byte << 8)
}
