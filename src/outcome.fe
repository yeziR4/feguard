// FairDice pure outcome and payout logic.
//
// This module has no storage and no EVM context (`ctx`). It is compiled twice
// from the exact same Fe source:
//   1. Into the on-chain EVM `FairDice` contract (`--backend sonatina`).
//   2. Into the off-chain WASM verifier (`--backend wasm`).
//
// House edge: explicit 2% (98% theoretical RTP, before integer wei truncation)
// for BOTH game modes, verified exhaustively by `node scripts/crash-rtp.mjs --check`:
//   - Dice:  valid targets 1..=95; wins when `roll(...) < target`;
//            payout `wager * 98 / target` (exact 98% RTP at every target).
//   - Crash: valid targets 105..=9800 (1.05x..=98.00x); wins when `target <= crash_point(u)`
//            where `u = crash_draw(...)` in `0..1_000_000` and
//            `crash_point(u) = min(9800, 98 * 1_000_000 / (1_000_000 - u))`.

use core::hash::keccak_words

pub const MIN_TARGET: u8 = 1
pub const MAX_TARGET: u8 = 95
pub const DICE_SIDES: u256 = 100
pub const HOUSE_RTP_NUM: u256 = 98

pub fn is_valid_target(_ target: u8) -> bool {
    target >= MIN_TARGET && target <= MAX_TARGET
}

/// Pure, deterministic commit hash for a 256-bit seed:
/// `keccak256(abi.encode(seed))`.
pub fn commit_seed(_ seed: u256) -> u256 {
    keccak_words([seed])
}

/// Pure, deterministic dice roll in `0..100` (`0..=99`).
/// Shared verbatim between the EVM contract and the WASM verifier.
pub fn roll(server_seed: u256, client_seed: u256, bet_id: u256) -> u256 {
    keccak_words([server_seed, client_seed, bet_id]) % DICE_SIDES
}

/// Maximum payout for a winning bet with the given wager and target.
/// Returns 0 if `target` is out of range.
pub fn max_payout(wager: u256, target: u8) -> u256 {
    if !is_valid_target(target) {
        return 0
    }
    (wager * HOUSE_RTP_NUM) / (target as u256)
}

/// Deterministic payout function (Invariant I2).
/// Wins when `outcome < target`; otherwise returns 0.
pub fn compute_payout(wager: u256, target: u8, outcome: u256) -> u256 {
    if !is_valid_target(target) {
        return 0
    }
    if outcome < (target as u256) {
        max_payout(wager, target)
    } else {
        0
    }
}

// =====================================================================
// Crash mode (additive): inverse-CDF curve over a 1,000,000-draw uniform
// space (`crash_draw`), delivering 98% RTP across all legal targets
// `1.05x..=98.00x` (scaled by 100: `150` = 1.50x).
// =====================================================================

pub const MODE_DICE: u8 = 0
pub const MODE_CRASH: u8 = 1
pub const CRASH_DRAWS: u256 = 1_000_000
pub const MIN_CRASH_MULT_X100: u256 = 105
pub const MAX_CRASH_MULT_X100: u256 = 9800

pub fn is_valid_crash_target(_ mult_x100: u256) -> bool {
    mult_x100 >= MIN_CRASH_MULT_X100 && mult_x100 <= MAX_CRASH_MULT_X100
}

/// Pure, deterministic uniform draw in `0..CRASH_DRAWS` for Crash mode,
/// independent of the 100-sided dice `roll()`.
pub fn crash_draw(server_seed: u256, client_seed: u256, bet_id: u256) -> u256 {
    keccak_words([server_seed, client_seed, bet_id]) % CRASH_DRAWS
}

/// Deterministic crash multiplier (x100) from uniform `u in 0..CRASH_DRAWS`:
/// `crash_point(u) = min(MAX_CRASH_MULT_X100, (HOUSE_RTP_NUM * CRASH_DRAWS) / (CRASH_DRAWS - u))`.
/// Satisfies `P(crash_point(u) >= m) = 98 / m` (2% edge at every target).
pub fn crash_point(_ u: u256) -> u256 {
    if u >= CRASH_DRAWS {
        return 0
    }
    let c = (HOUSE_RTP_NUM * CRASH_DRAWS) / (CRASH_DRAWS - u)
    if c > MAX_CRASH_MULT_X100 {
        MAX_CRASH_MULT_X100
    } else {
        c
    }
}

/// Maximum payout for a Crash bet at target multiplier `mult_x100`.
pub fn crash_max_payout(wager: u256, mult_x100: u256) -> u256 {
    if !is_valid_crash_target(mult_x100) {
        return 0
    }
    (wager * mult_x100) / 100
}

/// Deterministic Crash payout function: wins iff `mult_x100 <= crash_point(u)`.
pub fn compute_crash_payout(wager: u256, mult_x100: u256, u: u256) -> u256 {
    if !is_valid_crash_target(mult_x100) {
        return 0
    }
    if mult_x100 <= crash_point(u) {
        crash_max_payout(wager, mult_x100)
    } else {
        0
    }
}
