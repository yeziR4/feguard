use std::evm::wei
#[cfg(target = "evm")]
use std::abi::Bytes32
#[cfg(target = "evm")]
use std::evm::Call
use ingot::outcome::{
    MIN_TARGET,
    MAX_TARGET,
    DICE_SIDES,
    MODE_CRASH,
    MIN_CRASH_MULT_X100,
    MAX_CRASH_MULT_X100,
    commit_seed,
    compute_crash_payout,
    compute_payout,
    crash_max_payout,
    crash_point,
    is_valid_crash_target,
    is_valid_target,
    max_payout,
    roll,
}
#[cfg(target = "evm")]
use ingot::dice::{Bet, EntropyV2Msg, FairDice, FairDiceMsg}

// Helper player contract for EVM tests: places bets on FairDice and accepts
// plain ETH payouts via its payable fallback arm.
#[cfg(target = "evm")]
pub msg TestPlayerMsg {
    #[selector = sol("bet(address,uint8,uint256)")]
    Bet { dice: Address, target: u8, client_commitment: u256 } -> u256,
    #[selector = sol("crashBet(address,uint256,uint256)")]
    CrashBet { dice: Address, target_mult_x100: u256, client_commitment: u256 } -> u256,
}

#[cfg(target = "evm")]
pub contract TestPlayer uses (ctx: Ctx, call: mut Call) {
    init() {}

    recv TestPlayerMsg {
        #[payable]
        Bet { dice, target, client_commitment } -> u256
        uses (ctx, mut call)
        {
            call.call(
                addr: dice,
                gas: 1500000,
                value: ctx.value(),
                message: FairDiceMsg::PlaceBet { target, client_commitment },
            )
        }

        #[payable]
        CrashBet { dice, target_mult_x100, client_commitment } -> u256
        uses (ctx, mut call)
        {
            call.call(
                addr: dice,
                gas: 1500000,
                value: ctx.value(),
                message: FairDiceMsg::PlaceCrashBet { target_mult_x100, client_commitment },
            )
        }
    }

    recv {
        #[payable]
        _ {}
    }
}

// Local mock of Pyth Entropy V2 for deterministic `fe test` coverage.
#[cfg(target = "evm")]
pub msg MockEntropyAdminMsg {
    #[selector = sol("deliver(address,uint64,bytes32)")]
    Deliver { consumer: Address, seq: u64, random_number: Bytes32 },
}

#[cfg(target = "evm")]
pub contract MockEntropy uses (ctx: Ctx, call: mut Call) {
    fee: u128,
    mut next_seq: u64,

    init(fee_wei: u128)
    uses (mut fee, mut next_seq)
    {
        fee = fee_wei
        next_seq = 1
    }

    recv EntropyV2Msg {
        GetFeeV2 -> u128 uses (fee) {
            fee
        }

        #[payable]
        RequestV2 -> u64 uses (ctx, fee, mut next_seq) {
            assert!(
                ctx.value() >= wei(fee as u256),
                "insufficient entropy fee",
            )
            let seq = next_seq
            next_seq = seq + 1
            seq
        }
    }

    recv MockEntropyAdminMsg {
        Deliver { consumer, seq, random_number } uses (ctx, mut call) {
            call.call(
                addr: consumer,
                gas: 1500000,
                value: Wei::zero(),
                message: FairDiceMsg::EntropyCallback {
                    sequence_number: seq,
                    provider: ctx.address(),
                    random_number,
                },
            )
        }
    }
}

#[test]
fn roll_is_deterministic_and_in_range() {
    let server_seed: u256 = 0x11112222333344445555666677778888
    let client_seed: u256 = 0xAAAABBBBCCCCDDDDEEEEFFFF00001111
    let a = roll(server_seed, client_seed, bet_id: 1)
    let b = roll(server_seed, client_seed, bet_id: 1)
    assert!(a == b)
    assert!(a < DICE_SIDES)
}

#[test]
fn tampered_seed_changes_outcome() {
    let server_seed: u256 = 0xCAFEBABE12345678
    let client_seed: u256 = 0xDEADBEEF99990001
    let honest = roll(server_seed, client_seed, bet_id: 1)
    let tampered_server = roll(server_seed: server_seed ^ 1, client_seed, bet_id: 1)
    let tampered_client = roll(server_seed, client_seed: client_seed ^ 1, bet_id: 1)
    assert!(honest != tampered_server || honest != tampered_client)
}

#[test]
fn commit_seed_is_binding() {
    let seed: u256 = 0x123456789ABCDEF
    let h1 = commit_seed(seed)
    let h2 = commit_seed(seed)
    let h3 = commit_seed(seed ^ 1)
    assert!(h1 == h2)
    assert!(h1 != h3)
    assert!(h1 != 0)
}

#[test]
fn payout_enforces_house_edge_and_target_bounds() {
    // Invariant I4: target bounds
    assert!(!is_valid_target(0))
    assert!(is_valid_target(MIN_TARGET))
    assert!(is_valid_target(MAX_TARGET))
    assert!(!is_valid_target(96))
    assert!(max_payout(wager: 1000, target: 0) == 0)
    assert!(max_payout(wager: 1000, target: 96) == 0)

    // Explicit 2% house edge: target 49 -> 49% win chance, exact 2.00x payout
    assert!(max_payout(wager: 1000, target: 49) == 2000)
    assert!(
        compute_payout(wager: 1000, target: 49, outcome: 0) == 2000,
    )
    assert!(
        compute_payout(wager: 1000, target: 49, outcome: 48) == 2000,
    )
    // Losing roll (outcome >= target) pays 0 (Invariant I2)
    assert!(compute_payout(wager: 1000, target: 49, outcome: 49) == 0)
    assert!(compute_payout(wager: 1000, target: 49, outcome: 99) == 0)
}

// Invariants I2, I3, I5 + Pyth Entropy V2 callback path:
// TestPlayer places a bet (paying wager + entropy fee), MockEntropy delivers
// randomness via `_entropyCallback`, and FairDice settles using shared `roll()`.
#[test(balance = 1000000)]
#[cfg(target = "evm")]
fn contract_entropy_callback_settles_with_shared_roll() uses (evm: mut Evm) {
    let entropy_val: u256 = 0x1111222233334444
    let client_commit: u256 = 0x5555666677778888
    let fee: u128 = 100

    let entropy = evm.create2<MockEntropy>(value: Wei::zero(), args: (fee,), salt: 10)
    let dice = evm.create2<FairDice>(value: Wei::zero(), args: (wei(10000), entropy), salt: 0)
    let player = evm.create2<TestPlayer>(value: Wei::zero(), args: (), salt: 1)

    // Fund bankroll with 50,000 wei
    evm.call(
        addr: dice,
        gas: 2000000,
        value: wei(50000),
        message: FairDiceMsg::Fund {},
    )

    let stored_entropy: Address = evm
        .call(
            addr: dice,
            gas: 1000000,
            value: Wei::zero(),
            message: FairDiceMsg::GetEntropy {},
        )
    assert!(stored_entropy == entropy)

    // Cross-target equivalence vector: WASM `fg_roll` returns 25 for these exact inputs.
    let expected_outcome = roll(
        server_seed: entropy_val,
        client_seed: client_commit,
        bet_id: 1,
    )
    assert!(expected_outcome == 25)
    let target: u8 = 26
    let wager: u256 = 1000
    let expected_payout = compute_payout(wager, target, outcome: expected_outcome)
    assert!(expected_payout == 3769)

    // Player sends wager + entropy fee
    let bet_id: u256 = evm
        .call(
            addr: player,
            gas: 2000000,
            value: wei(wager + (fee as u256)),
            message: TestPlayerMsg::Bet { dice, target, client_commitment: client_commit },
        )
    assert!(bet_id == 1)

    // Entropy provider delivers randomness via `_entropyCallback`
    evm.call(
        addr: entropy,
        gas: 2000000,
        value: Wei::zero(),
        message: MockEntropyAdminMsg::Deliver {
            consumer: dice,
            seq: 1,
            random_number: Bytes32 { val: entropy_val },
        },
    )

    let bet: Bet = evm
        .call(
            addr: dice,
            gas: 1000000,
            value: Wei::zero(),
            message: FairDiceMsg::GetBet { bet_id: 1 },
        )
    assert!(bet.settled)
    assert!(bet.player == player)
    assert!(bet.wager == wei(wager))
    assert!(bet.sequence_number == 1)
    assert!(bet.entropy_value == entropy_val)
    assert!(bet.outcome == expected_outcome)
    assert!(bet.payout == wei(expected_payout))

    // Verify player received the exact ETH payout and bankroll accounting matches
    assert!(evm.balance(player) == wei(expected_payout))
    assert!(evm.balance(entropy) == wei(fee as u256))
    let bankroll_after: Wei = evm
        .call(
            addr: dice,
            gas: 1000000,
            value: Wei::zero(),
            message: FairDiceMsg::Bankroll {},
        )
    assert!(bankroll_after == wei(50000 + wager - expected_payout))
}

// Invariant I5: callback from any caller other than the configured Entropy contract MUST revert
#[test(should_revert, balance = 1000000)]
#[cfg(target = "evm")]
fn contract_rejects_wrong_caller_entropy_callback() uses (evm: mut Evm) {
    let entropy = evm.create2<MockEntropy>(value: Wei::zero(), args: (100 as u128,), salt: 10)
    let dice = evm.create2<FairDice>(value: Wei::zero(), args: (wei(10000), entropy), salt: 0)
    let player = evm.create2<TestPlayer>(value: Wei::zero(), args: (), salt: 1)
    evm.call(
        addr: dice,
        gas: 2000000,
        value: wei(50000),
        message: FairDiceMsg::Fund {},
    )
    let _: u256 = evm
        .call(
            addr: player,
            gas: 2000000,
            value: wei(1100),
            message: TestPlayerMsg::Bet { dice, target: 49, client_commitment: 0x5555 },
        )
    // Calling EntropyCallback directly from evm.address() (not `entropy`) must revert Unauthorized
    evm.call(
        addr: dice,
        gas: 2000000,
        value: Wei::zero(),
        message: FairDiceMsg::EntropyCallback {
            sequence_number: 1,
            provider: evm.address(),
            random_number: Bytes32 { val: 0x1111 },
        },
    )
}

// Invariant I1: a bet settles at most once (second callback reverts AlreadySettled)
#[test(should_revert, balance = 1000000)]
#[cfg(target = "evm")]
fn contract_rejects_double_settle() uses (evm: mut Evm) {
    let entropy = evm.create2<MockEntropy>(value: Wei::zero(), args: (100 as u128,), salt: 10)
    let dice = evm.create2<FairDice>(value: Wei::zero(), args: (wei(10000), entropy), salt: 0)
    let player = evm.create2<TestPlayer>(value: Wei::zero(), args: (), salt: 1)
    evm.call(
        addr: dice,
        gas: 2000000,
        value: wei(50000),
        message: FairDiceMsg::Fund {},
    )
    let _: u256 = evm
        .call(
            addr: player,
            gas: 2000000,
            value: wei(1100),
            message: TestPlayerMsg::Bet { dice, target: 49, client_commitment: 0x5555 },
        )
    evm.call(
        addr: entropy,
        gas: 2000000,
        value: Wei::zero(),
        message: MockEntropyAdminMsg::Deliver {
            consumer: dice,
            seq: 1,
            random_number: Bytes32 { val: 0x1111 },
        },
    )
    // Second callback for same sequence must revert AlreadySettled
    evm.call(
        addr: entropy,
        gas: 2000000,
        value: Wei::zero(),
        message: MockEntropyAdminMsg::Deliver {
            consumer: dice,
            seq: 1,
            random_number: Bytes32 { val: 0x1111 },
        },
    )
}

// Invariant I4: msg.value <= entropy fee leaves zero wager -> reverts ZeroWager
#[test(should_revert, balance = 1000000)]
#[cfg(target = "evm")]
fn contract_rejects_zero_wager() uses (evm: mut Evm) {
    let entropy = evm.create2<MockEntropy>(value: Wei::zero(), args: (100 as u128,), salt: 10)
    let dice = evm.create2<FairDice>(value: Wei::zero(), args: (wei(10000), entropy), salt: 0)
    evm.call(
        addr: dice,
        gas: 2000000,
        value: wei(50000),
        message: FairDiceMsg::Fund {},
    )
    let _: u256 = evm
        .call(
            addr: dice,
            gas: 2000000,
            value: wei(100),
            message: FairDiceMsg::PlaceBet { target: 49, client_commitment: 0x5555 },
        )
}

