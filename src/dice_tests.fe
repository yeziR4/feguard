}

// Invariant I3: contract rejects bets whose max payout exceeds bankroll
#[test(should_revert, balance = 1000000)]
#[cfg(target = "evm")]
fn contract_rejects_insufficient_bankroll() uses (evm: mut Evm) {
    let entropy = evm.create2<MockEntropy>(value: Wei::zero(), args: (100 as u128,), salt: 10)
    let dice = evm.create2<FairDice>(value: Wei::zero(), args: (wei(10000), entropy), salt: 0)
    // No bankroll funded; wager = 1000, target = 10 -> max payout = 9800 > 1000
    let _: u256 = evm
        .call(
            addr: dice,
            gas: 2000000,
            value: wei(1100),
            message: FairDiceMsg::PlaceBet { target: 10, client_commitment: 0x5555 },
        )
}

