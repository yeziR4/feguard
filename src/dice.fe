// FairDice: provably-fair dice casino powered by Pyth Entropy V2 in Fe 26.7.0.
// Reference implementation only — NOT audited and NOT production-ready.
//
// Invariants enforced by this contract:
//   I1  A bet settles at most once (`bet.settled` is checked and flipped before
//       any ETH transfer or external interaction).
//   I2  Outcome and payout equal `roll(entropy_value, client_commitment, bet_id)`
//       and `compute_payout(wager, target, outcome)` from `src/outcome.fe` — the
//       exact same Fe source compiled to WASM.
//   I3  The contract never pays more than `ctx.balance(ctx.address())` at settle time.
//   I4  `wager > 0` (after deducting the Pyth Entropy V2 fee) and `target` in `1..=95`.
//   I5  Neither player nor house controls or can withhold the randomness: `placeBet`
//       locks `client_commitment` and requests V2 randomness from Pyth Entropy;
//       only the configured Entropy contract may invoke `_entropyCallback`.
//       `refundExpired` is strictly a provider-failure escape hatch after 256 blocks.

#[cfg(target = "evm")]
use std::abi::Bytes32
#[cfg(target = "evm")]
use std::evm::{Call, Log, StorageMap, revert_error, wei}
use ingot::outcome::{
    MODE_DICE,
    MODE_CRASH,
    compute_crash_payout,
    compute_payout,
    crash_max_payout,
    crash_point,
    is_valid_crash_target,
    is_valid_target,
    max_payout,
    roll,
}

pub const REFUND_DELAY_BLOCKS: u256 = 256

#[abi]
pub struct Bet {
    pub player: Address,
    pub wager: Wei,
    pub target: u8,
    pub client_commitment: u256,
    pub sequence_number: u64,
    pub block_number: u256,
    pub settled: bool,
    pub outcome: u256,
    pub payout: Wei,
    pub entropy_value: u256,
    pub mode: u8,
    pub crash_target: u256,
}

impl Copy for Bet {}
impl Snapshot for Bet {}

#[cfg(target = "evm")]
#[error]
pub struct ZeroWager {}

#[cfg(target = "evm")]
#[error]
pub struct TargetOutOfRange { pub target: u8 }

#[cfg(target = "evm")]
#[error]
pub struct CrashTargetOutOfRange { pub target_mult_x100: u256 }

#[cfg(target = "evm")]
#[error]
pub struct ExceedsHouseCap { pub wager: Wei, pub cap: Wei }

#[cfg(target = "evm")]
#[error]
pub struct InsufficientBankroll { pub max_payout: Wei, pub available: Wei }

#[cfg(target = "evm")]
#[error]
pub struct InvalidCommitment {}

#[cfg(target = "evm")]
#[error]
pub struct InvalidEntropy {}

#[cfg(target = "evm")]
#[error]
pub struct BetNotFound { pub bet_id: u256 }

#[cfg(target = "evm")]
#[error]
pub struct AlreadySettled { pub bet_id: u256 }

#[cfg(target = "evm")]
#[error]
pub struct NotExpired { pub bet_id: u256 }

#[cfg(target = "evm")]
#[error]
pub struct TransferFailed {}

#[cfg(target = "evm")]
#[error]
pub struct Unauthorized {}

#[cfg(target = "evm")]
#[event]
pub struct BetPlaced {
    #[indexed]
    pub bet_id: u256,
    #[indexed]
    pub player: Address,
    pub wager: Wei,
    pub target: u8,
    pub commitment: u256,
    pub sequence_number: u64,
}

#[cfg(target = "evm")]
#[event]
pub struct BetSettled {
    #[indexed]
    pub bet_id: u256,
    #[indexed]
    pub sequence_number: u64,
    pub entropy_value: u256,
    pub client_commitment: u256,
    pub outcome: u256,
    pub payout: Wei,
}

#[cfg(target = "evm")]
#[event]
pub struct BetRefunded {
    #[indexed]
    pub bet_id: u256,
    #[indexed]
    pub player: Address,
    pub wager: Wei,
}

// External ABI for Pyth Entropy V2 (`IEntropyV2`), verified against Base Sepolia
// proxy `0x41c9e39574F40Ad34c79f1C99B66A45eFB830d4c` (impl `0x8dedb260...`).
#[cfg(target = "evm")]
pub msg EntropyV2Msg {
    #[selector = sol("getFeeV2()")]
    GetFeeV2 -> u128,
    #[selector = sol("requestV2()")]
    RequestV2 -> u64,
}

#[cfg(target = "evm")]
pub msg FairDiceMsg {
    #[selector = sol("placeBet(uint8,uint256)")]
    PlaceBet { target: u8, client_commitment: u256 } -> u256,
    #[selector = sol("placeCrashBet(uint256,uint256)")]
    PlaceCrashBet { target_mult_x100: u256, client_commitment: u256 } -> u256,
    // Verified on-chain selector 0x52a5f1f8 in Pyth Entropy V2 implementation bytecode.
    #[selector = sol("_entropyCallback(uint64,address,bytes32)")]
    EntropyCallback { sequence_number: u64, provider: Address, random_number: Bytes32 },
    #[selector = sol("refundExpired(uint256)")]
    RefundExpired { bet_id: u256 },
    #[selector = sol("fund()")]
    Fund,
    #[selector = sol("getBet(uint256)")]
    GetBet { bet_id: u256 } -> Bet,
    #[selector = sol("bankroll()")]
    Bankroll -> Wei,
    #[selector = sol("houseCap()")]
    HouseCap -> Wei,
    #[selector = sol("totalBets()")]
    TotalBets -> u256,
    #[selector = sol("getEntropy()")]
    GetEntropy -> Address,
}

#[cfg(target = "evm")]
pub contract FairDice uses (ctx: Ctx, log: mut Log, call: mut Call) {
    house: Address,
    house_cap: Wei,
    entropy: Address,
    mut bet_count: u256,
    mut bets: StorageMap<u256, Bet>,
    mut seq_to_bet: StorageMap<u64, u256>,

    init(cap: Wei, entropy_addr: Address)
    uses (ctx, mut house, mut house_cap, mut entropy, mut bet_count)
    {
        if entropy_addr == Address::new(0) {
            revert_error(InvalidEntropy {})
        }
        house = ctx.caller()
        house_cap = cap
        entropy = entropy_addr
        bet_count = 0
    }

    recv FairDiceMsg {
        #[payable]
        Fund {}

        #[payable]
        PlaceBet { target, client_commitment } -> u256
        uses (ctx, mut log, mut call, house_cap, entropy, mut bet_count, mut bets, mut seq_to_bet)
        {
            // Fetch current Pyth Entropy V2 fee and deduct it from msg.value.
            let fee: u128 = call
                .call(
                    addr: entropy,
                    gas: 100000,
                    value: Wei::zero(),
                    message: EntropyV2Msg::GetFeeV2 {},
                )
            let fee_wei = wei(fee as u256)

            // Invariant I4: wager (msg.value - fee) > 0 and target in range (1..=95)
            if ctx.value() <= fee_wei {
                revert_error(ZeroWager {})
            }
            let wager = ctx.value() - fee_wei
            if !is_valid_target(target) {
                revert_error(TargetOutOfRange { target })
            }
            if wager > house_cap {
                revert_error(ExceedsHouseCap { wager, cap: house_cap })
            }
            // Invariant I5: client commitment must be non-zero at bet time
            if client_commitment == 0 {
                revert_error(InvalidCommitment {})
            }

            // Invariant I3 pre-check: bankroll after paying Entropy fee must cover max payout
            let max_pay = wei(max_payout(wager: wager.as_wei(), target))
            let available = ctx.balance(ctx.address()) - fee_wei
            if max_pay > available {
                revert_error(InsufficientBankroll { max_payout: max_pay, available })
            }

            // Request randomness from Pyth Entropy V2; neither party can withhold the callback.
            let seq: u64 = call
                .call(
                    addr: entropy,
                    gas: 500000,
                    value: fee_wei,
                    message: EntropyV2Msg::RequestV2 {},
                )

            let bet_id = bet_count + 1
            bet_count = bet_id
            seq_to_bet[seq] = bet_id
            bets[bet_id] = Bet {
                player: ctx.caller(),
                wager,
                target,
                client_commitment,
                sequence_number: seq,
                block_number: ctx.block_number(),
                settled: false,
                outcome: 0,
                payout: Wei::zero(),
                entropy_value: 0,
                mode: MODE_DICE,
                crash_target: 0,
            }
            log.emit(
                BetPlaced {
                    bet_id,
                    player: ctx.caller(),
                    wager,
                    target,
                    commitment: client_commitment,
                    sequence_number: seq,
                },
            )
            bet_id
        }

        // Second game mode (Crash) on the same contract, Pyth Entropy V2 flow,
        // and settlement invariants. `target_mult_x100` is scaled by 100 (e.g. 150 = 1.50x).
        #[payable]
        PlaceCrashBet { target_mult_x100, client_commitment } -> u256
        uses (ctx, mut log, mut call, house_cap, entropy, mut bet_count, mut bets, mut seq_to_bet)
        {
            let fee: u128 = call
                .call(
                    addr: entropy,
                    gas: 100000,
                    value: Wei::zero(),
                    message: EntropyV2Msg::GetFeeV2 {},
                )
            let fee_wei = wei(fee as u256)

            if ctx.value() <= fee_wei {
                revert_error(ZeroWager {})
            }
            let wager = ctx.value() - fee_wei
            if !is_valid_crash_target(target_mult_x100) {
                revert_error(CrashTargetOutOfRange { target_mult_x100 })
            }
            if wager > house_cap {
                revert_error(ExceedsHouseCap { wager, cap: house_cap })
            }
            if client_commitment == 0 {
                revert_error(InvalidCommitment {})
            }

            let max_pay = wei(
                crash_max_payout(wager: wager.as_wei(), mult_x100: target_mult_x100),
            )
            let available = ctx.balance(ctx.address()) - fee_wei
            if max_pay > available {
                revert_error(InsufficientBankroll { max_payout: max_pay, available })
            }

            let seq: u64 = call
                .call(
                    addr: entropy,
                    gas: 500000,
                    value: fee_wei,
                    message: EntropyV2Msg::RequestV2 {},
                )

            let bet_id = bet_count + 1
            bet_count = bet_id
            seq_to_bet[seq] = bet_id
            bets[bet_id] = Bet {
                player: ctx.caller(),
                wager,
                target: 0,
                client_commitment,
                sequence_number: seq,
                block_number: ctx.block_number(),
                settled: false,
                outcome: 0,
                payout: Wei::zero(),
                entropy_value: 0,
                mode: MODE_CRASH,
                crash_target: target_mult_x100,
            }
            log.emit(
                BetPlaced {
                    bet_id,
                    player: ctx.caller(),
                    wager,
                    target: 0,
                    commitment: client_commitment,
                    sequence_number: seq,
                },
            )
            bet_id
        }

        // Pyth Entropy V2 callback (`_entropyCallback(uint64,address,bytes32)`).
        // Only the configured Entropy contract may invoke this handler.
        EntropyCallback { sequence_number, provider: _, random_number }
        uses (ctx, mut log, mut call, entropy, mut bets, seq_to_bet)
        {
            if ctx.caller() != entropy {
                revert_error(Unauthorized {})
            }
            let bet_id = seq_to_bet[sequence_number]
            if bet_id == 0 {
                revert_error(BetNotFound { bet_id })
            }
            var bet = bets[bet_id]
            // Invariant I1: a bet settles at most once.
            if bet.settled {
                revert_error(AlreadySettled { bet_id })
            }

            // Invariant I2: deterministic outcome and payout from shared `src/outcome.fe`.
            let entropy_val = random_number.val
            let u = roll(
                server_seed: entropy_val,
                client_seed: bet.client_commitment,
                bet_id,
            )
            let (outcome, payout) = if bet.mode == MODE_CRASH {
                (
                    crash_point(u),
                    wei(
                        compute_crash_payout(
                            wager: bet.wager.as_wei(),
                            mult_x100: bet.crash_target,
                            u,
                        ),
                    ),
                )
            } else {
                (u, wei(
                        compute_payout(wager: bet.wager.as_wei(), target: bet.target, outcome: u),
                    ))
            }

            // Invariant I3: never pay more than the contract balance at settle time.
            let available = ctx.balance(ctx.address())
            if payout > available {
                revert_error(InsufficientBankroll { max_payout: payout, available })
            }

            // Effects before external call (CEI + I1).
            bet.settled = true
            bet.outcome = outcome
            bet.payout = payout
            bet.entropy_value = entropy_val
            bets[bet_id] = bet

            if payout > Wei::zero() {
                let outcome_call = call.send_value(addr: bet.player, gas: 100000, value: payout)
                if !outcome_call.success() {
                    revert_error(TransferFailed {})
                }
            }

            log.emit(
                BetSettled {
                    bet_id,
                    sequence_number,
                    entropy_value: entropy_val,
                    client_commitment: bet.client_commitment,
                    outcome,
                    payout,
                },
            )
        }

        // Permissionless provider-failure escape hatch: if Pyth Entropy fails to
        // deliver a callback within `REFUND_DELAY_BLOCKS` blocks, anyone may
        // refund `bet.wager` back to `bet.player`.
        RefundExpired { bet_id } uses (ctx, mut log, mut call, bet_count, mut bets) {
            if bet_id == 0 || bet_id > bet_count {
                revert_error(BetNotFound { bet_id })
            }
            var bet = bets[bet_id]
            if bet.settled {
                revert_error(AlreadySettled { bet_id })
            }
            if ctx.block_number() < bet.block_number + REFUND_DELAY_BLOCKS {
                revert_error(NotExpired { bet_id })
            }
            let available = ctx.balance(ctx.address())
            if bet.wager > available {
                revert_error(InsufficientBankroll { max_payout: bet.wager, available })
            }

            bet.settled = true
            bet.payout = bet.wager
            bets[bet_id] = bet

            let outcome_call = call.send_value(addr: bet.player, gas: 100000, value: bet.wager)
            if !outcome_call.success() {
                revert_error(TransferFailed {})
            }

            log.emit(
                BetRefunded { bet_id, player: bet.player, wager: bet.wager },
            )
        }

        GetBet { bet_id } -> Bet uses (bets) {
            bets[bet_id]
        }

        Bankroll -> Wei uses (ctx) {
            ctx.balance(ctx.address())
        }

        HouseCap -> Wei uses (house_cap) {
            house_cap
        }

        TotalBets -> u256 uses (bet_count) {
            bet_count
        }

        GetEntropy -> Address uses (entropy) {
            entropy
        }
    }
}
