// Generated by FeGuard; intentional mutant 1, seed 0.
// Copy this file into src/ and run: fe test --filter exported_counterexample
use ingot::fuzz::{Action, empty_trace, replay, one_minimal}
use ingot::guard_machine::guard

#[test]
fn exported_counterexample() {
    var trace = empty_trace()
    trace.len = 9
    trace.actions[0] = Action { opcode: 0, value: 1 }
    trace.actions[1] = Action { opcode: 0, value: 0 }
    trace.actions[2] = Action { opcode: 0, value: 0 }
    trace.actions[3] = Action { opcode: 7, value: 0 }
    trace.actions[4] = Action { opcode: 0, value: 0 }
    trace.actions[5] = Action { opcode: 0, value: 0 }
    trace.actions[6] = Action { opcode: 7, value: 0 }
    trace.actions[7] = Action { opcode: 1, value: 0 }
    trace.actions[8] = Action { opcode: 7, value: 0 }
    var mutant = guard(1)
    assert!(replay(mut mutant, trace).code == 1)
    assert!(one_minimal(mut mutant, trace, code: 1))
    var fixed = guard(0)
    assert!(replay(mut fixed, trace).code == 0)
}
